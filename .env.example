# SmartRanker Environment Configuration

# Deployment environment (development | production | test)
NODE_ENV=production

# Public application URL for staging/production (used for canonical references)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# File Upload Constraints
# Note: Ensure hosting platform body size limits match (e.g., 4.5MB for Vercel serverless functions, 50MB+ for Docker/Node containers)
NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB=10
NEXT_PUBLIC_MAX_RESUME_FILES=25

# Semantic Matching & Embeddings (Optional - Server-side secret)
# If omitted, SmartRanker gracefully falls back to deterministic skill/taxonomy/experience matching with 100% availability.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
