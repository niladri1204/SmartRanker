# SmartRanker Environment Configuration

# Deployment environment (development | production | test)
NODE_ENV=production

# Public application URL for staging/production (e.g., https://smart-ranker-staging.onrender.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# File Upload Constraints
# Note: For the Render staging deployment, the batch limit is configured to 9 resumes (at 10MB each = 90MB nominal)
# to guarantee total multipart request payloads remain safely under Render's documented 100MB HTTP request body limit.
# This is a hosting-specific staging configuration, not a universal application limit.
NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB=10
NEXT_PUBLIC_MAX_RESUME_FILES=9

# Semantic Matching & Embeddings (Optional - Server-side secret)
# If omitted, SmartRanker gracefully falls back to deterministic skill/taxonomy/experience matching with 100% availability.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
